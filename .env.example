# Copie este arquivo para .env e troque as senhas. O .env nunca vai para o Git (está no .gitignore).

# Banco de dados
DB_NAME=cofrelo
DB_USER=cofrelo
DB_PASS=troque-esta-senha
DB_ROOT_PASS=troque-esta-senha-tambem

# Aplicação
APP_PORTA=8080
# Cria a usuária de demonstração (Mariana) quando o banco está vazio.
SEED_DEMO=true

# Versão da imagem usada pelo script de implantação (scripts/implantar.ps1)
COFRELO_IMAGEM=ghcr.io/danmarangon/cofrelo-app
COFRELO_VERSAO=latest

# Observabilidade (perfil opcional do Docker Compose)
GRAFANA_SENHA=troque-esta-senha-do-grafana

# ------------------------------------------------------------------------------------------
# No XAMPP, sem Docker, use estes valores (o MySQL do XAMPP vem com root sem senha):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=cofrelo
# DB_USER=root
# DB_PASS=
# LOG_DESTINO=storage/logs/cofrelo.log
