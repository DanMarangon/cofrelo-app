{
    "name": "danmarangon/cofrelo",
    "description": "Cofrelo: sistema web de controle financeiro pessoal em PHP e MySQL",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Cofrelo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cofrelo\\Testes\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unitarios": "phpunit --testsuite unitarios",
        "test:integracao": "phpunit --testsuite integracao"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
